{
  "app": {
    "name": "Apple The Exchange TRX",
    "type": "mobile_storefront",
    "platform": "mobile-only",
    "framework": "react-web",
    "design_system": "design_system.json"
  },
  "AppShell": {
    "description": "Primary application shell for the main navigation experience.",
    "layout": {
      "direction": "column",
      "height": "100%",
      "min_height": 0,
      "overflow": "hidden",
      "display": "flex",
      "width": "100%",
      "max_width": "500px",
      "margin": "0 auto"
    },
    "components": {
      "GlobalHeader": {
        "visible": true,
        "position": "static",
        "height": 56,
        "items": [
          "logo",
          "notification",
          "cart",
          "profile"
        ]
      },
      "MainContent": {
        "visible": true,
        "flex": 1,
        "min_height": 0,
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "screens": [
          {
            "id": "home",
            "layout": {
              "scrollable": true,
              "overflow_y": "auto",
              "overflow_x": "hidden",
              "padding_horizontal": 16,
              "padding_top": 16,
              "padding_bottom": 24
            },
            "components": [
              {
                "component": "HeroBanner",
                "children": [
                  "HeroImage",
                  "Eyebrow",
                  "Title",
                  "Description",
                  "PrimaryButton",
                  "PaginationIndicator"
                ]
              },
              {
                "component": "FeaturedCategories",
                "item_component": "CategoryItem",
                "children": [
                  "SectionHeader",
                  "CategoryHorizontalList"
                ]
              },
              {
                "component": "FeaturedProducts",
                "item_component": "ProductCard",
                "data_source": "featured_products",
                "children": [
                  "SectionHeader",
                  "ProductGrid"
                ]
              },
              {
                "component": "NewArrivals",
                "item_component": "ProductCard",
                "data_source": "new_arrivals",
                "children": [
                  "SectionHeader",
                  "ProductHorizontalList"
                ]
              },
              {
                "component": "Promotions",
                "item_component": "PromotionCard",
                "children": [
                  "SectionHeader",
                  "PromotionCardList"
                ]
              }
            ]
          },
          {
            "id": "products",
            "layout": {
              "scrollable": true,
              "overflow_y": "auto",
              "overflow_x": "hidden",
              "padding_horizontal": 16,
              "padding_top": 16,
              "padding_bottom": 24
            },
            "components": [
              {
                "component": "PageHeader",
                "children": [
                  "PageTitle",
                  "ProductCount"
                ]
              },
              {
                "component": "SearchBar",
                "children": [
                  "SearchInput",
                  "SearchIcon",
                  "ClearButton"
                ]
              },
              {
                "component": "CategoryFilter",
                "selection": "single",
                "source": "product_catalog.categories",
                "children": [
                  "CategoryChipList"
                ]
              },
              {
                "component": "ProductToolbar",
                "children": [
                  "SortSelector",
                  "FilterButton",
                  "ViewModeToggle"
                ]
              },
              {
                "component": "ActiveFilterList",
                "children": [
                  "FilterChip",
                  "ClearAllButton"
                ]
              },
              {
                "component": "ProductGrid",
                "data_source": "products",
                "columns": 2,
                "children": [
                  "ProductCard"
                ]
              },
              {
                "component": "PaginationOrLoadMore",
                "children": [
                  "LoadMoreButton",
                  "LoadingIndicator"
                ]
              },
              {
                "component": "EmptyState",
                "children": [
                  "EmptyIllustration",
                  "Title",
                  "Description",
                  "ClearFiltersButton"
                ]
              },
              {
                "component": "ErrorState",
                "children": [
                  "ErrorIcon",
                  "Title",
                  "RetryButton"
                ]
              }
            ]
          },
          {
            "id": "profile",
            "layout": {
              "scrollable": true,
              "overflow_y": "auto",
              "overflow_x": "hidden",
              "padding_horizontal": 16,
              "padding_top": 16,
              "padding_bottom": 24
            },
            "components": [
              {
                "component": "ProfileSummary",
                "children": [
                  "Avatar",
                  "UserName",
                  "Email",
                  "EditProfileButton"
                ]
              },
              {
                "component": "OrderShortcut",
                "children": [
                  "SectionHeader",
                  "ViewAllButton",
                  "OrderStatusShortcuts"
                ]
              },
              {
                "component": "AccountMenu",
                "items": [
                  "My Account",
                  "My Orders",
                  "My Addresses",
                  "Payment Methods"
                ],
                "children": [
                  "MenuItem"
                ]
              },
              {
                "component": "SupportMenu",
                "items": [
                  "Notifications",
                  "Help Center",
                  "About"
                ],
                "children": [
                  "MenuItem"
                ]
              },
              {
                "component": "SettingsSection",
                "children": [
                  "ThemeSelector",
                  "SignOutButton"
                ]
              }
            ]
          }
        ]
      },
      "BottomNavigation": {
        "visible": true,
        "position": "static",
        "height": 64,
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "house",
            "path": "/"
          },
          {
            "id": "products",
            "label": "Products",
            "icon": "grid-2x2",
            "path": "/products"
          },
          {
            "id": "livechat",
            "label": "Live Chat",
            "icon": "message-circle",
            "path": "/livechat"
          },
          {
            "id": "profile",
            "label": "Profile",
            "icon": "user-round",
            "path": "/profile"
          }
        ]
      }
    }
  },
  "StandalonePages": [
    {
      "id": "notifications",
      "page": "NotificationsPage",
      "path": "/notifications",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "PageHeader",
          "children": [
            "BackButton",
            "PageTitle",
            "MarkAllAsReadButton"
          ]
        },
        {
          "component": "NotificationFilter",
          "tabs": [
            "All",
            "Unread"
          ],
          "children": [
            "FilterTab"
          ]
        },
        {
          "component": "NotificationList",
          "item_fields": [
            "Icon",
            "Title",
            "Message",
            "Timestamp",
            "UnreadIndicator",
            "ActionLink"
          ],
          "children": [
            "NotificationItem"
          ]
        },
        {
          "component": "EmptyState",
          "children": [
            "EmptyIcon",
            "Title",
            "Description"
          ]
        },
        {
          "component": "LoadingState",
          "children": [
            "SkeletonNotificationItem"
          ]
        },
        {
          "component": "ErrorState",
          "children": [
            "ErrorMessage",
            "RetryButton"
          ]
        }
      ]
    },
    {
      "id": "cart",
      "page": "CartPage",
      "path": "/cart",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "PageHeader",
          "children": [
            "BackButton",
            "PageTitle",
            "CartItemCount"
          ]
        },
        {
          "component": "CartSelectionBar",
          "children": [
            "SelectAllCheckbox",
            "RemoveSelectedButton"
          ]
        },
        {
          "component": "CartItemList",
          "item_fields": [
            "SelectionCheckbox",
            "ProductImage",
            "ProductName",
            "VariantSummary",
            "UnitPrice",
            "QuantityStepper",
            "RemoveButton",
            "ItemSubtotal"
          ],
          "children": [
            "CartItem"
          ]
        },
        {
          "component": "CartSummary",
          "children": [
            "SubtotalRow",
            "DiscountRow",
            "TotalRow"
          ]
        },
        {
          "component": "EmptyCartState",
          "children": [
            "CartIcon",
            "Title",
            "Description",
            "ContinueShoppingButton"
          ]
        },
        {
          "component": "BottomAction",
          "position": "static_in_page_flow",
          "children": [
            "CheckoutButton"
          ]
        }
      ]
    },
    {
      "id": "livechat",
      "page": "LiveChatPage",
      "path": "/livechat",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "ChatHeader",
          "children": [
            "BackButton",
            "SupportAvatar",
            "SupportName",
            "OnlineStatus",
            "MoreActionsButton"
          ]
        },
        {
          "component": "ConversationInfo",
          "children": [
            "DateDivider",
            "WelcomeMessage"
          ]
        },
        {
          "component": "MessageList",
          "children": [
            "MessageBubble",
            "MessageTimestamp",
            "MessageStatus",
            "TypingIndicator"
          ]
        },
        {
          "component": "ChatComposer",
          "children": [
            "AttachmentButton",
            "MessageInput",
            "EmojiButton",
            "SendButton"
          ]
        },
        {
          "component": "ChatEmptyState",
          "children": [
            "SupportIcon",
            "Title",
            "Description"
          ]
        },
        {
          "component": "ChatErrorState",
          "children": [
            "ErrorMessage",
            "RetryButton"
          ]
        }
      ]
    },
    {
      "id": "product_detail",
      "page": "ProductDetailPage",
      "path": "/product/:id",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "ProductImageGallery",
          "children": [
            "MainProductImage",
            "ThumbnailList",
            "ImagePagination"
          ]
        },
        {
          "component": "ProductHeading",
          "children": [
            "ProductName",
            "BrandLabel",
            "NewBadge",
            "WishlistButton"
          ]
        },
        {
          "component": "ProductPricing",
          "children": [
            "CurrentPrice",
            "OriginalPrice",
            "DiscountBadge",
            "InstallmentOrPriceNote"
          ]
        },
        {
          "component": "ProductAvailability",
          "children": [
            "AvailabilityBadge",
            "StockMessage"
          ]
        },
        {
          "component": "ProductVariantSelector",
          "children": [
            "ColorSelector",
            "StorageSelector",
            "VariantPrice"
          ]
        },
        {
          "component": "ProductQuantitySelector",
          "children": [
            "DecreaseButton",
            "QuantityValue",
            "IncreaseButton"
          ]
        },
        {
          "component": "ProductDescription",
          "children": [
            "SectionHeader",
            "DescriptionText",
            "RichTextDescription"
          ]
        },
        {
          "component": "ProductSpecifications",
          "children": [
            "SectionHeader",
            "SpecificationList"
          ]
        },
        {
          "component": "ProductInformationAccordion",
          "children": [
            "DeliveryInformation",
            "ReturnsInformation",
            "WarrantyInformation"
          ]
        },
        {
          "component": "RelatedProducts",
          "item_component": "ProductCard",
          "children": [
            "SectionHeader",
            "ProductHorizontalList"
          ]
        },
        {
          "component": "BottomAction",
          "position": "static_in_page_flow",
          "children": [
            "AddToCartButton",
            "BuyNowButton"
          ]
        }
      ]
    },
    {
      "id": "checkout",
      "page": "CheckoutPage",
      "path": "/checkout",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "PageHeader",
          "children": [
            "BackButton",
            "PageTitle",
            "SecureCheckoutIndicator"
          ]
        },
        {
          "component": "ShippingAddressSection",
          "children": [
            "SectionHeader",
            "SelectedAddressCard",
            "ChangeAddressButton",
            "AddAddressButton"
          ]
        },
        {
          "component": "OrderItemsSection",
          "item_fields": [
            "ProductImage",
            "ProductName",
            "VariantSummary",
            "Quantity",
            "Price"
          ],
          "children": [
            "SectionHeader",
            "CheckoutItem"
          ]
        },
        {
          "component": "DeliverySection",
          "fixed_shipping_fee": "RM 52.00",
          "children": [
            "DeliveryMethod",
            "DeliveryFee"
          ]
        },
        {
          "component": "PaymentMethodSection",
          "status": "undecided",
          "methods": [],
          "children": [
            "SectionHeader",
            "PaymentMethodPlaceholder",
            "ChoosePaymentMethodButton"
          ]
        },
        {
          "component": "PriceSummary",
          "children": [
            "SubtotalRow",
            "ShippingFeeRow",
            "DiscountRow",
            "TotalRow"
          ]
        },
        {
          "component": "CheckoutValidation",
          "children": [
            "InlineErrorMessage"
          ]
        },
        {
          "component": "BottomAction",
          "position": "static_in_page_flow",
          "children": [
            "PlaceOrderButton"
          ]
        }
      ]
    },
    {
      "id": "order_success",
      "page": "OrderSuccessPage",
      "path": "/order-success",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "SuccessHeader",
          "children": [
            "SuccessIcon",
            "SuccessTitle",
            "SuccessDescription"
          ]
        },
        {
          "component": "OrderReference",
          "children": [
            "OrderNumber",
            "CopyOrderNumberButton",
            "OrderDate"
          ]
        },
        {
          "component": "OrderSummary",
          "children": [
            "OrderItemPreview",
            "ItemsCount",
            "TotalPaid"
          ]
        },
        {
          "component": "NextSteps",
          "children": [
            "DeliveryInformation",
            "ConfirmationMessage"
          ]
        },
        {
          "component": "PrimaryActions",
          "children": [
            "ViewOrderButton",
            "ContinueShoppingButton"
          ]
        }
      ]
    },
    {
      "id": "orders",
      "page": "OrdersPage",
      "path": "/orders",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "PageHeader",
          "children": [
            "BackButton",
            "PageTitle"
          ]
        },
        {
          "component": "OrderFilterTabs",
          "tabs": [
            "All",
            "Pending",
            "Processing",
            "Shipped",
            "Completed",
            "Cancelled"
          ],
          "children": [
            "FilterTab"
          ]
        },
        {
          "component": "OrderList",
          "item_fields": [
            "OrderNumber",
            "OrderDate",
            "OrderStatusBadge",
            "ProductPreview",
            "ItemCount",
            "OrderTotal",
            "ViewDetailsButton"
          ],
          "children": [
            "OrderCard"
          ]
        },
        {
          "component": "EmptyState",
          "children": [
            "OrderIcon",
            "Title",
            "Description",
            "StartShoppingButton"
          ]
        },
        {
          "component": "LoadingState",
          "children": [
            "SkeletonOrderCard"
          ]
        },
        {
          "component": "ErrorState",
          "children": [
            "ErrorMessage",
            "RetryButton"
          ]
        }
      ]
    },
    {
      "id": "order_detail",
      "page": "OrderDetailPage",
      "path": "/orders/:id",
      "layout": {
        "scrollable": true,
        "overflow_y": "auto",
        "overflow_x": "hidden",
        "padding_horizontal": 16,
        "padding_top": 16,
        "padding_bottom": 24
      },
      "components": [
        {
          "component": "PageHeader",
          "children": [
            "BackButton",
            "PageTitle",
            "MoreActionsButton"
          ]
        },
        {
          "component": "OrderStatusSection",
          "children": [
            "OrderStatusBadge",
            "StatusDescription",
            "LastUpdated"
          ]
        },
        {
          "component": "OrderTrackingTimeline",
          "steps": [
            "OrderPlaced",
            "Processing",
            "Shipped",
            "OutForDelivery",
            "Delivered"
          ],
          "show_timestamp": true,
          "children": [
            "TrackingStep"
          ]
        },
        {
          "component": "OrderInformation",
          "children": [
            "OrderNumber",
            "OrderDate",
            "PaymentStatus",
            "CopyOrderNumberButton"
          ]
        },
        {
          "component": "ShippingAddressSection",
          "children": [
            "RecipientName",
            "PhoneNumber",
            "FullAddress"
          ]
        },
        {
          "component": "OrderItemsSection",
          "item_fields": [
            "ProductImage",
            "ProductName",
            "VariantSummary",
            "Quantity",
            "UnitPrice",
            "LineTotal"
          ],
          "children": [
            "OrderItem"
          ]
        },
        {
          "component": "PaymentSummary",
          "children": [
            "SubtotalRow",
            "ShippingFeeRow",
            "DiscountRow",
            "TotalRow"
          ]
        },
        {
          "component": "OrderActions",
          "children": [
            "ContactSupportButton",
            "CancelOrderButton",
            "BuyAgainButton"
          ]
        }
      ]
    }
  ],
  "Overlay": {
    "description": "Global overlay layer rendered above the active application page.",
    "components": {
      "Modal": {
        "enabled": true,
        "position": "center",
        "backdrop": true,
        "close_on_backdrop": true,
        "close_button": true,
        "z_index": 70
      },
      "BottomSheet": {
        "enabled": true,
        "position": "bottom",
        "border_radius": "20px 20px 0 0",
        "backdrop": true,
        "drag_handle": true,
        "safe_area_bottom": true,
        "z_index": 80
      },
      "Toast": {
        "enabled": true,
        "position": "top",
        "duration": 3000,
        "variants": [
          "success",
          "error",
          "warning",
          "info"
        ],
        "z_index": 90
      }
    }
  }
}